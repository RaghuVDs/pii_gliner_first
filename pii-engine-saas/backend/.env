# Local development — services running via docker-compose, backend running locally
DATABASE_URL=postgresql+asyncpg://pii_user:pii_pass@localhost:5432/pii_engine
MONGODB_URL=mongodb://pii_user:pii_pass@localhost:27017/pii_engine?authSource=admin
MONGODB_DATABASE=pii_engine
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
JWT_SECRET_KEY=dev-secret-key-change-in-production-64chars-long-abcdefghijklmnop
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
GLINER_MODEL_NAME=data/gliner-pii-model
LOG_LEVEL=info
APP_NAME=PII Engine SaaS API
APP_VERSION=1.0.0
